<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>0.8.1</Version>
    <Description>AutomationML Editor plugin that exports trees, attribute panels, the window or any region as vector graphics (SVG, PDF, PNG) for papers and slides. Shortcuts: Ctrl+Shift+E complete tree, Ctrl+Shift+K tree to clipboard, Ctrl+Shift+W whole window, Ctrl+Shift+R drag a region. Options in the SvgExport panel.</Description>
    <PackageTags>AMLEditor; AMLEditorPlugin.Net; AutomationML; CAEX; SVG; Export</PackageTags>
    <Authors>Hamied Nabizada</Authors>
    <Copyright>Copyright (c) 2026 Hamied Nabizada and contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/hsu-aut/AMLSvgExport</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hsu-aut/AMLSvgExport</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <BaseOutputPath>$(SolutionDir)build\Plugins\$(MSBuildProjectName)</BaseOutputPath>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aml.Editor.Plugin.Contract" Version="4.3.0">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <!-- Provided by the editor at run time. PrivateAssets keeps it out of the package's
         dependencies, so installing the plugin downloads nothing else from nuget.org. -->
    <PackageReference Include="Aml.Engine" Version="4.5.2">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aml.Editor.Plugin.SvgExport.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Metadata.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(OutputPath)$(AssemblyName).deps.json" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
