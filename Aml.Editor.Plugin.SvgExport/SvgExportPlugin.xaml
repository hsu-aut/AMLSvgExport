<aml:PluginViewBase
    x:Class="Aml.Editor.Plugin.SvgExport.SvgExportPlugin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:aml="clr-namespace:Aml.Editor.Plugin.WPFBase;assembly=Aml.Editor.Plugin.Contract"
    mc:Ignorable="d"
    d:DesignHeight="640" d:DesignWidth="380">

    <!-- No colors of its own: font, foreground and background come from the editor theme.
         Secondary text is expressed with opacity so it works in light and dark themes. -->
    <aml:PluginViewBase.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style x:Key="Option" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </aml:PluginViewBase.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,10,12,12">

            <TextBlock Style="{StaticResource Hint}"
                       Text="Exports editor views as vector graphics: trees, attribute panels, the window or any region. Shortcuts work anywhere in the editor, also while this panel is closed."/>

            <!-- Export actions -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Export"/>
            <UniformGrid x:Name="ActionGrid" Columns="2" Margin="0,0,-6,0"/>

            <DockPanel Margin="0,4,0,0">
                <TextBlock DockPanel.Dock="Left" Text="Tree:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Padding="4" Margin="6,0,0,0"
                        ToolTip="Search the editor for trees again" Click="RefreshButton_Click"/>
                <ComboBox x:Name="TreeCombo" ToolTip="The tree used by Export tree and Copy tree. Clicking into a tree in the editor selects it here."/>
            </DockPanel>

            <!-- Result of the last export -->
            <Border x:Name="ResultPanel" Visibility="Collapsed" Margin="0,12,0,0" Padding="10,8"
                    BorderThickness="1" CornerRadius="3">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#808080" Opacity="0.4"/>
                </Border.BorderBrush>
                <DockPanel>
                    <ContentControl x:Name="ResultIcon" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <StackPanel>
                        <TextBlock x:Name="ResultTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ResultDetail" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                        <StackPanel x:Name="ResultButtons" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="OpenFileButton" Padding="8,3" Margin="0,0,6,0" Click="OpenFileButton_Click"/>
                            <Button x:Name="ShowInFolderButton" Padding="8,3" Click="ShowInFolderButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Options, grouped by what they affect -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Output"/>
            <StackPanel x:Name="OutputOptions" CheckBox.Click="Option_Changed">
                <TextBlock Text="Export tree writes" Margin="0,0,0,4"/>
                <ComboBox x:Name="TreeVariantCombo" Margin="0,0,0,8" SelectionChanged="TreeVariantCombo_SelectionChanged"
                          ToolTip="Which part of the tree's panel Export tree and Copy tree take."/>
                <CheckBox x:Name="VisibleTreeOnlyToggle" Style="{StaticResource Option}" Content="Only the visible part of the tree" Margin="0,0,0,10"
                          ToolTip="Takes the tree as currently shown, including its scroll position. Off: the complete tree, including rows scrolled out of view."/>
                <CheckBox x:Name="PdfToggle" Style="{StaticResource Option}" Content="Also save as PDF (for LaTeX)"
                          ToolTip="Same size as the SVG. Rendered with the installed Microsoft Edge."/>
                <CheckBox x:Name="PngToggle" Style="{StaticResource Option}" Content="Also save as PNG, 2× resolution (for slides)"
                          ToolTip="Rendered with the installed Microsoft Edge."/>
                <CheckBox x:Name="ClipboardToggle" Style="{StaticResource Option}" Content="Also copy to clipboard"
                          ToolTip="SVG as text (paste into Inkscape) and as image (paste into PowerPoint or Word)."/>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Appearance"/>
            <StackPanel x:Name="AppearanceOptions" CheckBox.Click="Option_Changed">
                <CheckBox x:Name="SuppressHoverToggle" Style="{StaticResource Option}" Content="Hide mouse hover highlight"
                          ToolTip="The row or button under the mouse pointer is exported without its hover highlight."/>
                <CheckBox x:Name="HideSelectionToggle" Style="{StaticResource Option}" Content="Hide selection highlight"
                          ToolTip="Unselects the selected row for the export and selects it again afterwards. Panels that follow the selection, such as the attribute details, are then empty in the export."/>
                <CheckBox x:Name="WarnCutTextToggle" Style="{StaticResource Option}" Content="Warn if text is cut off"
                          ToolTip="After the export, reports values the editor shows only partly (e.g. long IDs in the attribute details), so you can widen the panel and export again."/>
                <CheckBox x:Name="CropToggle" Style="{StaticResource Option}" Content="Crop empty space"
                          ToolTip="Cuts empty space on the right and at the bottom, e.g. the grey area below a short attribute list."/>
                <CheckBox x:Name="DiagramsAsVectorToggle" Style="{StaticResource Option}" Content="Plugin diagrams as vector"
                          ToolTip="Browser-based plugin views (e.g. Petri net, FPB): the diagram is taken as vector graphics. Palettes and other HTML parts are then missing; switch off to get an image with everything."/>
                <CheckBox x:Name="TextAsPathsToggle" Style="{StaticResource Option}" Content="Text as outlines"
                          ToolTip="Converts text to shapes. Looks identical everywhere, but text can no longer be edited."/>
            </StackPanel>

            <Expander Header="Activity log" Margin="0,12,0,0">
                <TextBox x:Name="StatusLog" IsReadOnly="True" TextWrapping="Wrap" Height="180" Margin="0,6,0,0"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</aml:PluginViewBase>
